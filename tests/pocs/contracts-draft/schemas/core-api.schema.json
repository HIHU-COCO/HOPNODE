{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hopnode.invalid/draft/core-api.schema.json",
  "title": "DRAFT HopNode common type candidates",
  "$comment": "DRAFT by HIHU-COCO, 2026-10-19. Only a subset of K01. Types and lexical constraints are provisional; no IPC framing or production compatibility claim.",
  "$ref": "#/$defs/OperationResult",
  "$defs": {
    "ID": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "Timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$",
      "$comment": "DRAFT: lexical UTC shape only; calendar validation remains TODO."
    },
    "PageRequest": {
      "type": "object",
      "properties": {
        "page_size": {
          "type": "integer",
          "minimum": 1
        },
        "cursor": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "Device": {
      "type": "object",
      "properties": {
        "device_id": {
          "$ref": "#/$defs/ID"
        },
        "source": {
          "enum": [
            "manual_ssh",
            "managed"
          ]
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "roles": {
          "type": "array",
          "items": {
            "enum": [
              "controller",
              "agent"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "network_status": {
          "enum": [
            "online",
            "pending",
            "offline",
            "unknown"
          ]
        },
        "ssh_status": {
          "enum": [
            "ready",
            "unavailable",
            "auth_failed",
            "unknown"
          ]
        },
        "connection_type": {
          "enum": [
            "direct",
            "relay",
            "peer_relay",
            "unknown"
          ]
        },
        "agent_enabled": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "identity_status": {
          "enum": [
            "active",
            "suspended",
            "revoked",
            "retired",
            null
          ]
        },
        "last_seen_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "observed_at": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "required": [
        "device_id",
        "source",
        "display_name",
        "roles",
        "network_status",
        "ssh_status",
        "connection_type",
        "agent_enabled",
        "identity_status",
        "last_seen_at",
        "observed_at"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "source": {
                "const": "manual_ssh"
              }
            },
            "required": [
              "source"
            ]
          },
          "then": {
            "properties": {
              "network_status": {
                "const": "unknown"
              },
              "agent_enabled": {
                "type": "null"
              },
              "identity_status": {
                "type": "null"
              },
              "last_seen_at": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "source": {
                "const": "managed"
              }
            },
            "required": [
              "source"
            ]
          },
          "then": {
            "properties": {
              "agent_enabled": {
                "type": "boolean"
              },
              "identity_status": {
                "enum": [
                  "active",
                  "suspended",
                  "revoked",
                  "retired"
                ]
              }
            }
          }
        }
      ]
    },
    "DevicePage": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Device"
          }
        },
        "next_cursor": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "observed_at": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "required": [
        "items",
        "next_cursor",
        "observed_at"
      ],
      "additionalProperties": false
    },
    "Versions": {
      "type": "object",
      "properties": {
        "app_version": {
          "type": "string",
          "minLength": 1
        },
        "ipc_major": {
          "type": "integer",
          "minimum": 0
        },
        "ipc_minor": {
          "type": "integer",
          "minimum": 0
        },
        "store_schema_version": {
          "type": "integer",
          "minimum": 0
        },
        "mcp_tool_schema_version": {
          "type": "string",
          "minLength": 1
        },
        "directory_api_version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "app_version",
        "ipc_major",
        "ipc_minor",
        "store_schema_version",
        "mcp_tool_schema_version",
        "directory_api_version"
      ],
      "additionalProperties": false
    },
    "Capabilities": {
      "type": "object",
      "properties": {
        "versions": {
          "$ref": "#/$defs/Versions"
        },
        "ipc_compatibility": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "major": {
                "type": "integer",
                "minimum": 0
              },
              "min_minor": {
                "type": "integer",
                "minimum": 0
              },
              "max_minor": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "major",
              "min_minor",
              "max_minor"
            ],
            "additionalProperties": false
          }
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "availability": {
                "enum": [
                  "available",
                  "unavailable",
                  "unknown"
                ]
              },
              "reason_code": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "name",
              "availability"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "versions",
        "ipc_compatibility",
        "capabilities"
      ],
      "additionalProperties": false
    },
    "Cancellation": {
      "type": "object",
      "properties": {
        "requested": {
          "type": "boolean"
        },
        "accepted": {
          "type": "boolean"
        },
        "confirmed": {
          "type": "boolean"
        },
        "confirmed_at": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "required": [
        "requested",
        "accepted",
        "confirmed"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "accepted": {
                "const": true
              }
            },
            "required": [
              "accepted"
            ]
          },
          "then": {
            "properties": {
              "requested": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "confirmed": {
                "const": true
              }
            },
            "required": [
              "confirmed"
            ]
          },
          "then": {
            "properties": {
              "requested": {
                "const": true
              },
              "accepted": {
                "const": true
              }
            },
            "required": [
              "confirmed_at"
            ]
          },
          "else": {
            "not": {
              "required": [
                "confirmed_at"
              ]
            }
          }
        }
      ]
    },
    "OperationResult": {
      "type": "object",
      "properties": {
        "device_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/ID"
            },
            {
              "type": "null"
            }
          ]
        },
        "operation_id": {
          "$ref": "#/$defs/ID"
        },
        "task_id": {
          "$ref": "#/$defs/ID"
        },
        "status": {
          "enum": [
            "queued",
            "running",
            "succeeded",
            "failed",
            "canceled",
            "unknown"
          ]
        },
        "data": {
          "type": [
            "object",
            "null"
          ]
        },
        "error": {
          "anyOf": [
            {
              "$ref": "errors.schema.json"
            },
            {
              "type": "null"
            }
          ]
        },
        "cancellation": {
          "$ref": "#/$defs/Cancellation"
        }
      },
      "required": [
        "device_id",
        "operation_id",
        "status",
        "data",
        "error"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "queued",
                  "running",
                  "succeeded"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "error": {
                "type": "null"
              },
              "data": {
                "type": "object"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "failed"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "error": {
                "$ref": "errors.schema.json"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "unknown"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "error": {
                "allOf": [
                  {
                    "$ref": "errors.schema.json"
                  },
                  {
                    "properties": {
                      "code": {
                        "enum": [
                          "UNKNOWN_OUTCOME",
                          "TASK_STATUS_UNKNOWN"
                        ]
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "error": {
                "type": "object",
                "properties": {
                  "code": {
                    "enum": [
                      "UNKNOWN_OUTCOME",
                      "TASK_STATUS_UNKNOWN"
                    ]
                  }
                },
                "required": [
                  "code"
                ]
              }
            },
            "required": [
              "error"
            ]
          },
          "then": {
            "properties": {
              "status": {
                "const": "unknown"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "canceled"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "cancellation"
            ],
            "properties": {
              "cancellation": {
                "properties": {
                  "confirmed": {
                    "const": true
                  }
                },
                "required": [
                  "confirmed"
                ]
              },
              "error": {
                "allOf": [
                  {
                    "$ref": "errors.schema.json"
                  },
                  {
                    "properties": {
                      "code": {
                        "const": "CANCELED"
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "cancellation": {
                "properties": {
                  "confirmed": {
                    "const": true
                  }
                },
                "required": [
                  "confirmed"
                ]
              }
            },
            "required": [
              "cancellation"
            ]
          },
          "then": {
            "properties": {
              "status": {
                "const": "canceled"
              }
            }
          }
        }
      ]
    },
    "Task": {
      "type": "object",
      "properties": {
        "device_id": {
          "$ref": "#/$defs/ID"
        },
        "operation_id": {
          "$ref": "#/$defs/ID"
        },
        "task_id": {
          "$ref": "#/$defs/ID"
        },
        "status": {
          "enum": [
            "queued",
            "running",
            "succeeded",
            "failed",
            "canceled",
            "unknown"
          ]
        },
        "exit_code": {
          "type": [
            "integer",
            "null"
          ]
        },
        "timed_out": {
          "type": "boolean"
        },
        "observed_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "cancellation": {
          "$ref": "#/$defs/Cancellation"
        }
      },
      "required": [
        "device_id",
        "operation_id",
        "task_id",
        "status",
        "exit_code",
        "timed_out",
        "observed_at"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "queued",
                  "running",
                  "unknown"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "exit_code": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "succeeded"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "exit_code": {
                "const": 0
              }
            }
          }
        },
        {
          "then": {
            "properties": {
              "cancellation": {
                "properties": {
                  "confirmed": {
                    "const": true
                  }
                },
                "required": [
                  "confirmed"
                ]
              }
            },
            "required": [
              "cancellation"
            ]
          },
          "if": {
            "properties": {
              "status": {
                "const": "canceled"
              }
            },
            "required": [
              "status"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "cancellation": {
                "properties": {
                  "confirmed": {
                    "const": true
                  }
                },
                "required": [
                  "confirmed"
                ]
              }
            },
            "required": [
              "cancellation"
            ]
          },
          "then": {
            "properties": {
              "status": {
                "const": "canceled"
              }
            }
          }
        }
      ]
    },
    "TaskTarget": {
      "type": "object",
      "properties": {
        "device_id": {
          "$ref": "#/$defs/ID"
        },
        "task_id": {
          "$ref": "#/$defs/ID"
        }
      },
      "required": [
        "device_id",
        "task_id"
      ],
      "additionalProperties": false
    },
    "CancelTaskInput": {
      "type": "object",
      "properties": {
        "device_id": {
          "$ref": "#/$defs/ID"
        },
        "task_id": {
          "$ref": "#/$defs/ID"
        },
        "operation_id": {
          "$ref": "#/$defs/ID"
        }
      },
      "required": [
        "device_id",
        "task_id",
        "operation_id"
      ],
      "additionalProperties": false
    },
    "OperationTarget": {
      "type": "object",
      "properties": {
        "device_id": {
          "$ref": "#/$defs/ID"
        },
        "operation_id": {
          "$ref": "#/$defs/ID"
        }
      },
      "required": [
        "device_id",
        "operation_id"
      ],
      "additionalProperties": false
    },
    "CoreRequest": {
      "type": "object",
      "properties": {
        "request_id": {
          "$ref": "#/$defs/ID"
        },
        "ipc_major": {
          "type": "integer",
          "minimum": 0
        },
        "ipc_minor": {
          "type": "integer",
          "minimum": 0
        },
        "method": {
          "enum": [
            "GetCapabilities",
            "ListDevices",
            "GetTask",
            "CancelTask",
            "GetOperation",
            "CancelOperation"
          ]
        },
        "params": {
          "type": "object"
        }
      },
      "required": [
        "request_id",
        "ipc_major",
        "ipc_minor",
        "method",
        "params"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "method": {
                "const": "GetCapabilities"
              }
            },
            "required": [
              "method"
            ]
          },
          "then": {
            "properties": {
              "params": {
                "type": "object",
                "properties": {
                  "client_app_version": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "client_app_version"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "method": {
                "const": "ListDevices"
              }
            },
            "required": [
              "method"
            ]
          },
          "then": {
            "properties": {
              "params": {
                "$ref": "#/$defs/PageRequest"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "method": {
                "const": "GetTask"
              }
            },
            "required": [
              "method"
            ]
          },
          "then": {
            "properties": {
              "params": {
                "$ref": "#/$defs/TaskTarget"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "method": {
                "const": "CancelTask"
              }
            },
            "required": [
              "method"
            ]
          },
          "then": {
            "properties": {
              "params": {
                "$ref": "#/$defs/CancelTaskInput"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "method": {
                "const": "GetOperation"
              }
            },
            "required": [
              "method"
            ]
          },
          "then": {
            "properties": {
              "params": {
                "$ref": "#/$defs/OperationTarget"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "method": {
                "const": "CancelOperation"
              }
            },
            "required": [
              "method"
            ]
          },
          "then": {
            "properties": {
              "params": {
                "$ref": "#/$defs/OperationTarget"
              }
            }
          }
        }
      ]
    }
  }
}
