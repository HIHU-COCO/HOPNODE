{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hopnode.invalid/draft/errors.schema.json",
  "title": "DRAFT HopNode business error candidate",
  "$comment": "DRAFT by HIHU-COCO, 2026-10-19. Not a frozen contract or runtime security proof.",
  "type": "object",
  "properties": {
    "code": {
      "enum": [
        "DEVICE_OFFLINE",
        "NETWORK_UNREACHABLE",
        "SSH_NOT_READY",
        "SSH_AUTH_FAILED",
        "SSH_HOST_KEY_CHANGED",
        "PERMISSION_DENIED",
        "MCP_NOT_CONNECTED",
        "TASK_STATUS_UNKNOWN",
        "FILE_CONFLICT",
        "SERVICE_NOT_RUNNING",
        "UNKNOWN_OUTCOME",
        "INVALID_ARGUMENT",
        "NOT_FOUND",
        "VERSION_INCOMPATIBLE",
        "CAPABILITY_UNAVAILABLE",
        "HOST_KEY_UNTRUSTED",
        "SSH_CONFIG_UNSUPPORTED",
        "DEVICE_REVOKED",
        "AGENT_DISABLED",
        "CANCELED",
        "TIMEOUT",
        "OPERATION_CONFLICT",
        "CURSOR_INVALID"
      ]
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "device_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "retryable": {
      "type": "boolean"
    },
    "details": {
      "type": "object",
      "properties": {
        "component": {
          "type": "string",
          "minLength": 1
        },
        "stage": {
          "type": "string",
          "minLength": 1
        },
        "expected_version": {
          "type": "string",
          "minLength": 1
        },
        "actual_version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "required": [
    "code",
    "message",
    "device_id",
    "retryable",
    "details"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "code": {
            "enum": [
              "UNKNOWN_OUTCOME",
              "TASK_STATUS_UNKNOWN"
            ]
          }
        },
        "required": [
          "code"
        ]
      },
      "then": {
        "properties": {
          "retryable": {
            "const": false
          }
        }
      }
    }
  ]
}
